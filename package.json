{
  "name": "florafauna_go_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watch --coverage=false",
    "test:ci": "jest --coverageDirectory=./__tests__/coverage --forceExit",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!**/jest.setup.js",
      "!**/*.config.{js,ts}",
      "!**/app/+html.tsx",
      "!**/app/+not-found.tsx"
    ],
    "coverageReporters": [
      "lcov"
    ]
  },
  "dependencies": {
    "@backpackapp-io/react-native-toast": "^0.14.0",
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/native": "^7.0.14",
    "@shopify/react-native-skia": "v2.0.0-next.4",
    "@tanstack/react-query": "^5.64.1",
    "events": "^3.3.0",
    "expo": "^53.0.9",
    "expo-audio": "~0.4.4",
    "expo-blur": "~14.1.4",
    "expo-camera": "~16.1.6",
    "expo-constants": "~17.1.6",
    "expo-font": "~13.3.1",
    "expo-image-manipulator": "^13.1.7",
    "expo-linear-gradient": "~14.1.4",
    "expo-linking": "~7.1.4",
    "expo-location": "~18.1.4",
    "expo-router": "~5.0.6",
    "expo-secure-store": "~14.2.3",
    "expo-sensors": "^14.1.4",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.7",
    "expo-web-browser": "~14.1.6",
    "react": "19.0.0",
    "react-content-loader": "^7.0.2",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-circular-progress": "^1.4.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-snap-carousel": "^4.0.0-beta.6",
    "react-native-svg": "15.11.2",
    "react-native-svg-circular-progress": "^1.0.4",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.20.0",
    "zod": "^3.25.7",
    "zustand": "^5.0.3",
    "expo-dev-client": "~5.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.10",
    "@types/react-native-snap-carousel": "^3.8.11",
    "@types/react-test-renderer": "^19.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.5",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
