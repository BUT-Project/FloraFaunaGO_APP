
# Google Maps API Key used for Android
# This key must be restricted in the Google Cloud Console to your Android package name and SHA-1 fingerprint
GOOGLE_MAPS_API_KEY_ANDROID=your-google-maps-api-key-for-android-here

# Google Maps API Key used for iOS
# This key must be restricted in the Google Cloud Console to your iOS bundle identifier
GOOGLE_MAPS_API_KEY_IOS=your-google-maps-api-key-for-ios-here

# Expo public API URL
# To add environment-specific variables on new lines in the form of EXPO_PUBLIC_[NAME]=VALUE
EXPO_PUBLIC_API_URL=https://codefirst.iut.uca.fr/containers/FloraFauna_GO-api
